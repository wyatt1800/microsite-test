---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import W9FormSection from '../components/W9FormSection.astro';
---

<BaseLayout
  title="Fill Out Your W-9 — W9 Helper"
  description="Complete your W-9 form online for free. Clear guidance at every field, download your PDF in minutes."
>
  <Nav currentPath="/form" />

  <main>
    <W9FormSection initialStep={1} />
  </main>

  <Footer />
</BaseLayout>
