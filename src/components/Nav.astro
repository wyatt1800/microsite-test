---
interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;
---

<nav style="background-color: var(--color-navy);" class="sticky top-0 z-50">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <div class="flex h-16 items-center justify-between">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 min-w-0">
        <img
          src="/logo.png"
          alt="W9 Helper"
          width="38"
          height="38"
          style="flex-shrink: 0; border-radius: 10px;"
        />
        <span style="font-family: 'Plus Jakarta Sans', system-ui, sans-serif; font-weight: 700; font-size: 17px; white-space: nowrap;">
          <span style="color: #fff;">W9</span><span style="color: var(--color-blue-mid); font-style: italic;">Helper</span>
        </span>
      </a>

      <!-- Nav links -->
      <div class="flex items-center gap-6">
        <a
          href="/#how-it-works"
          style="font-family: 'Plus Jakarta Sans', system-ui, sans-serif; font-size: 14px; font-weight: 600; color: var(--color-slate-mid); text-decoration: none;"
          class="hover:text-white transition-colors"
        >
          How it works
        </a>
        <a
          href="/guides"
          style={`font-family: 'Plus Jakarta Sans', system-ui, sans-serif; font-size: 14px; font-weight: 600; text-decoration: none; color: ${currentPath.startsWith('/guides') ? '#fff' : 'var(--color-slate-mid)'};`}
          class="hover:text-white transition-colors"
        >
          Guides
        </a>
        <a
          href="/form"
          style="font-family: 'Plus Jakarta Sans', system-ui, sans-serif; font-size: 13px; font-weight: 700; background-color: var(--color-blue); color: #fff; padding: 8px 20px; border-radius: 50px; text-decoration: none; box-shadow: 0 2px 10px rgba(65,105,232,0.40);"
          class="hover:opacity-90 transition-opacity hidden sm:inline-flex"
        >
          Start your W-9 →
        </a>
      </div>
    </div>
  </div>
</nav>
