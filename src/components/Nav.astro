---
import { Icon } from 'astro-icon/components';

interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;
---

<nav style="background-color: var(--color-navy);" class="sticky top-0 z-50">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <div class="flex h-16 items-center justify-between">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 min-w-0">
        <img
          src="/w9-helper-logo-light.png"
          alt="W9 Helper"
          width="98"
          height="30"
          style="flex-shrink: 0; height: 30px; width: auto;"
        />
      </a>

      <!-- Nav links -->
      <div class="flex items-center gap-6">
        <a
          href="/#how-it-works"
          style="font-family: 'Inter', system-ui, sans-serif; font-size: 14px; font-weight: 600; color: var(--color-slate-mid); text-decoration: none;"
          class="hover:text-white transition-colors"
        >
          How it works
        </a>
        <a
          href="/guides"
          style={`font-family: 'Inter', system-ui, sans-serif; font-size: 14px; font-weight: 600; text-decoration: none; color: ${currentPath.startsWith('/guides') ? '#fff' : 'var(--color-slate-mid)'};`}
          class="hover:text-white transition-colors"
        >
          Guides
        </a>
        <a
          href="/form"
          style="font-family: 'Poppins', system-ui, sans-serif; font-size: 13px; font-weight: 600; background-color: var(--color-blue); color: #fff; padding: 8px 20px; border-radius: 8px; text-decoration: none; box-shadow: 0 2px 10px rgba(21,84,209,0.40); display: inline-flex; align-items: center; gap: 6px;"
          class="hover:opacity-90 transition-opacity hidden sm:inline-flex"
        >
          Start your W-9
          <Icon name="tabler:arrow-right" width="15" height="15" />
        </a>
      </div>
    </div>
  </div>
</nav>
